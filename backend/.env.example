# =============================================================================
# BACKEND ENVIRONMENT - Example (copy to .env and fill in real values)
# =============================================================================
# In production: use real secrets; never commit .env to git.
# In development: placeholders below are valid for local runs (DB/Redis via Docker).
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# development | staging | production | test
NODE_ENV=development
# Port the API listens on (e.g. 4000 when frontend is on 3000)
PORT=4000
# URL path prefix for all API routes (must match frontend NEXT_PUBLIC_API_URL path)
API_PREFIX=/api/v1
# Primary frontend origin for cookie/CORS auth checks (production: https://cohold.co)
FRONTEND_URL=https://cohold.co
# Issue 9 — allowlisted browser origins (comma-separated). Merged with ADMIN_ALLOWED_ORIGINS.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://cohold.co
# Optional admin-panel-only origins (comma-separated).
# ADMIN_ALLOWED_ORIGINS=https://admin.cohold.co
# CORS_CREDENTIALS=true
# BODY_LIMIT=1mb
# ENABLE_SWAGGER=false
# If ENABLE_SWAGGER=true in production/staging, set docs basic-auth:
# SWAGGER_USERNAME=
# SWAGGER_PASSWORD=
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_LIMIT=100
# OUTBOX_WORKER_ENABLED=false
# OUTBOX_BATCH_SIZE=25
# OUTBOX_MAX_ATTEMPTS=5
# OUTBOX_BASE_DELAY_SECONDS=30
# OUTBOX_DEAD_LETTER_ALERT_THRESHOLD=25
# EMAIL_DELIVERY_ENABLED=true
# WEBSOCKET_DELIVERY_ENABLED=true
# Optional cookie domain override. Leave empty for host-only cookies (recommended).
# AUTH_COOKIE_DOMAIN=.cohold.onrender.com
# Legacy single origin alias (prefer CORS_ALLOWED_ORIGINS):
# CORS_ORIGIN=https://preview.cohold.co

# -----------------------------------------------------------------------------
# Database (REQUIRED for local run)
# -----------------------------------------------------------------------------
# Local PostgreSQL on Windows: use postgres user, create DB with: createdb cohold (or psql)
# Replace YOUR_PASSWORD with your Windows PostgreSQL postgres user password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cohold
# Redis optional (currently disabled – leave unset or comment out)
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# JWT – End users (REQUIRED; strong secrets in production)
# -----------------------------------------------------------------------------
# Min 32 characters. Production: e.g. openssl rand -base64 48 (64+ chars recommended).
JWT_ACCESS_SECRET=dev-access-secret-min-32-chars-change-in-prod
JWT_REFRESH_SECRET=dev-refresh-secret-min-32-chars-change-in-prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=cohold-api
JWT_AUDIENCE=cohold-client
# -----------------------------------------------------------------------------
# JWT – Admins (REQUIRED in production/staging; must differ from user secrets)
# -----------------------------------------------------------------------------
# Dev: omit to use derived dev-only suffixes on user secrets (see configuration.ts).
# Staging/production: set explicitly; startup fails if missing or equal to user secrets.
JWT_ADMIN_ACCESS_SECRET=dev-admin-access-secret-min-32-chars-change-in-prod
JWT_ADMIN_REFRESH_SECRET=dev-admin-refresh-secret-min-32-chars-change-in-prod
JWT_ADMIN_ISSUER=cohold-api
JWT_ADMIN_AUDIENCE=cohold-admin-panel
# JWT_ADMIN_ACCESS_EXPIRES_IN=15m
# JWT_ADMIN_REFRESH_EXPIRES_IN=7d
# Optional extra pepper for hashing refresh sessions in DB
# AUTH_SESSION_PEPPER=replace-with-strong-secret
# Max absolute refresh-chain lifetime (days)
AUTH_MAX_SESSION_LIFETIME_DAYS=30

# -----------------------------------------------------------------------------
# Paystack (REQUIRED in production/staging)
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
# Optional — frontend uses backend initialize URL only
# PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_CALLBACK_URL=http://localhost:3000/dashboard/wallet?payment=callback
PAYSTACK_ENV=test
# Dedicated virtual accounts (Paystack DVA)
PAYSTACK_VIRTUAL_ACCOUNT_ENABLED=true
# PAYSTACK_DVA_PREFERRED_BANK=wema-bank
# Withdrawal payouts via Paystack Transfers
PAYSTACK_TRANSFERS_ENABLED=false
APP_BASE_URL=http://localhost:3000
VIRTUAL_ACCOUNTS_ENABLED=true

# -----------------------------------------------------------------------------
# S3 / Cloudflare R2 (REQUIRED; must match your bucket)
# -----------------------------------------------------------------------------
# R2: R2 → Manage R2 API Tokens. S3: IAM access key. Dev: placeholders work if storage is optional.
S3_ACCESS_KEY=your_access_key_id
S3_SECRET_KEY=your_secret_access_key
S3_BUCKET=cohold-documents
# R2: use "auto". AWS: e.g. us-east-1
S3_REGION=auto
# R2: https://<account_id>.r2.cloudflarestorage.com. AWS: leave empty or use regional endpoint.
S3_ENDPOINT=https://xxxxxxxxxxxx.r2.cloudflarestorage.com

# -----------------------------------------------------------------------------
# Email (REQUIRED; e.g. SendGrid)
# -----------------------------------------------------------------------------
# SendGrid API key or other provider key. Production: use a real key; keep secret.
# Dev: placeholder disables sending (backend logs a warning but starts).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Elasticsearch node URL for search. Omit or leave empty to disable search.
# ELASTICSEARCH_NODE=http://localhost:9200
# FX rates: optional API key for exchangerate-api.io paid tier.
# EXCHANGE_RATE_API_KEY=
